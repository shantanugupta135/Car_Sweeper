# ---------------------------------------------------------------------------
# CarsGlow admin portal
#
# mock  — everything renders from lib/mock-admin-data.ts, no Supabase needed
# real  — the portal talks to the same Supabase project as the mobile app
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_MODE=mock

# Same values as sweeper-clean-expoapp/.env — public, safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional escalation, not required.
#
# The portal authorises through the signed-in admin's JWT and the society_admin
# RLS policies. The only privileged operation — creating a cleaner's auth user —
# runs in the admin-provision-cleaner edge function, which gets the service role
# key from Supabase automatically.
#
# Set this only if you would rather not deploy that function. It bypasses RLS
# entirely, so keep it server-side: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
